# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the env template (real keys stay in .env.local, which is ignored above)
!.env.example

# FG-NET dataset: academic-research licence, never commit it
/data/

# generated test images (may contain faces), keep out of the public repo
/scratch/
/eval/outputs/images/

# eval Python environment
/eval/.venv/
/eval/outputs/images_multi/
/eval/outputs/images_features/
/eval/outputs/images_sam/
/eval/outputs/images_nb2/
