{
  "name": "still-looking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "eval:generate": "node --no-warnings --env-file=.env.local eval/generate.mjs",
    "eval:multi": "node --no-warnings --env-file=.env.local eval/generate.mjs --multi",
    "eval:features": "node --no-warnings --env-file=.env.local eval/generate.mjs --features",
    "eval:score": "python eval/run_score.py",
    "eval:all": "npm run eval:generate && npm run eval:multi && npm run eval:features && npm run eval:score"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
