# Copy this file to .env.local and fill in your own values there (never commit .env.local).
# Both come from the Cloudflare dashboard, free plan, no credit card:
#   Account ID: dash.cloudflare.com -> Workers AI -> "Use REST API"
#   API token:  same page -> "Create a Workers AI API Token"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional, for development only. Saves the free daily AI allowance while testing.
#   mock  = no AI calls, the uploaded photo is sent back as the result (0 neurons)
#   cheap = 1 variation at 512px instead of 3 at 768px (about 7x less)
# Leave empty on the deployed site.
AI_MODE=

# Optional, eval only: Replicate token for the SAM comparison (eval/generate_sam.mjs)
REPLICATE_API_TOKEN=
